{
  "name": "foodbridge-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"vite\"",
    "dev:server": "tsc -p tsconfig.server.json && node dist-server/server/index.js",
